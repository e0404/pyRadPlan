{
  "name": "pyradplan-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser frontend for pyRadPlan (Pyodide in a web worker)",
  "scripts": {
    "predev": "npm run fixtures",
    "dev": "vite",
    "prebuild": "npm run fixtures",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run fixtures",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run fixtures",
    "test": "vitest run",
    "pretest:watch": "npm run fixtures",
    "test:watch": "vitest",
    "pree2e": "npm run fixtures",
    "e2e": "node e2e/run.mjs",
    "pree2e:pyodide": "npm run fixtures",
    "e2e:pyodide": "node e2e/pyodide.mjs",
    "pree2e:viewer": "npm run fixtures",
    "e2e:viewer": "node e2e/viewer.mjs",
    "pree2e:menus": "npm run fixtures",
    "e2e:menus": "node e2e/menus.mjs",
    "pree2e:plan": "npm run fixtures",
    "e2e:plan": "node e2e/plan.mjs",
    "pages:test": "node scripts/test_pages.mjs",
    "gen:colormaps": "python scripts/gen_colormaps.py",
    "fixtures": "node scripts/mock_fixtures.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.1",
    "pyodide": "314.0.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
