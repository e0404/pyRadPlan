# pyRadPlan AI Agents configuration
# Copy this file to .env and fill in your values.

# Model to use for AI agents (default: claude-sonnet-4-5)
# PYRADPLAN_AI_AGENTS_MODEL=claude-sonnet-4-5

# Display usage info for API calls (default: true)
# PYRADPLAN_AI_AGENTS_DISPLAY_USAGE=true

# API keys — set the one matching your chosen model's provider.
# pydantic-ai reads these directly; do not prefix them with PYRADPLAN_AI_.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...

# pyRadPlan data location

# Root directory for pyRadPlan's writable data (downloaded AI models and, later,
# datasets it fetches). Defaults to "~/.pyradplan". A "~" is expanded.
# PYRADPLAN_DATA_DIR=~/.pyradplan

# pyRadPlan AI model handling configuration

# Base directory for local AI models. Defaults to "<data_dir>/ai_models". When
# set, models are downloaded into / loaded from "<path>/<org>/<repo>" and used
# as the default local_dir for load_model(). Set to "" to use the HuggingFace
# cache only.
# PYRADPLAN_AI_MODELHUB_LOCAL_MODELS_DIR=/path/to/ai_models

# HF_HUB_DISABLE_SYMLINKS_WARNING=1 # suppress warning about symlinks

# HuggingFace organization/namespace hosting the model repositories.
# PYRADPLAN_AI_MODELHUB_HF_ORG=DKFZ-RadOpt

# HuggingFace cache directory (default: the HuggingFace default / HF_HOME)
# PYRADPLAN_AI_MODELHUB_CACHE_DIR=/path/to/hf_cache

# Force offline mode (only use cached / local files). (default: false)
# PYRADPLAN_AI_MODELHUB_OFFLINE=true

# Allow loading a model fetched from the HuggingFace Hub to execute the Python
# it ships (model.py, preprocessor.py). Only enable for sources you trust; a
# directory passed explicitly as load_model(local_dir=...) is exempt.
# (default: false)
# PYRADPLAN_AI_MODELHUB_TRUST_REMOTE_CODE=true

# Device to load models onto (default: cpu)
# PYRADPLAN_AI_MODELHUB_DEVICE=cuda
