# pyRadPlan AI Agents configuration
# Copy this file to .env and fill in your values.

# Model to use for AI agents (default: claude-sonnet-4-5)
# PYRADPLAN_AI_MODEL=claude-sonnet-4-5

# Display usage info for API calls (default: true)
# PYRADPLAN_AI_DISPLAY_USAGE=true

# API keys — set the one matching your chosen model's provider.
# pydantic-ai reads these directly; do not prefix them with PYRADPLAN_AI_.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=...
# MISTRAL_API_KEY=...
